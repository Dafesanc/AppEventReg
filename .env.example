# Copia este archivo como .env (no se sube a git) y completa los valores.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave SECRETA (sb_secret_... o la "service_role" legacy). Nunca la pongas en el frontend.
SUPABASE_SECRET_KEY=

# Contraseña para entrar a /admin y descargar el Excel.
ADMIN_PASSWORD=

# URL pública del sitio (sin / al final). Usada en robots.txt, sitemap, retorno de PayPhone
# y como host permitido para el SSR de Angular.
SITE_URL=http://localhost:4200
# Opcional: otros dominios que sirven la app (ej. tu-app.onrender.com), separados por coma.
# NG_ALLOWED_HOSTS=

# Opcional: pagos con tarjeta vía PayPhone (Payphone Developer → tu aplicación Web).
# Además debes poner cardPaymentsEnabled: true en src/app/shared/event.config.ts
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
