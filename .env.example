# Copia este archivo como .env (no se sube a git) y completa los valores.
# Lo leen `npm start` (dev server de Angular) y `npm run preview` (wrangler dev).
# En producción estos valores van como secrets de Cloudflare: npx wrangler secret put NOMBRE

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave SECRETA (sb_secret_... o la "service_role" legacy). Nunca la pongas en el frontend.
SUPABASE_SECRET_KEY=

# Contraseña para entrar a /admin y descargar el Excel.
ADMIN_PASSWORD=

# Opcional: pagos con tarjeta vía PayPhone (Payphone Developer → tu aplicación Web).
# Además debes poner cardPaymentsEnabled: true en src/app/shared/event.config.ts
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
